# =============================================================================
# Impekable Converge — Required Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MEDIA_STREAM_URL=
TWILIO_BASE_URL=
# Set to false for local development (bypasses Twilio signature checks on webhooks)
TWILIO_VALIDATE_SIGNATURES=true

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ENABLED=true

# --- Database (local profile only) ---
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=

# --- Database (Cloud Run / GCP) ---
GCP_SQL_USERNAME=postgres
GCP_SQL_DATABASE=postgres
GCP_SQL_INSTANCE_CONNECTION=
